# Copy to .env before `docker compose up` — compose reads this file for both
# variable substitution in docker-compose.yml and the backend container env.

# --- infrastructure (compose sets DATABASE_URL / REDIS_URL from these) -------
POSTGRES_USER=bakuroses
POSTGRES_PASSWORD=bakuroses
POSTGRES_DB=bakuroses_db

# host port mappings
FRONTEND_PORT=3000
BACKEND_PORT=3002
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- frontend (inlined into the client bundle at build time) ----------------
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_SOCKET_URL=http://localhost:3002
NEXT_PUBLIC_WHATSAPP_NUMBER=994XXXXXXXXX
CLIENT_URL=http://localhost:3000

# --- backend ----------------------------------------------------------------
# DESTRUCTIVE: the seed wipes products + order items before recreating them.
# Leave false and seed once by hand instead:
#   docker compose exec backend npx ts-node src/prisma/seed.ts
SEED_ON_START=false

API_URL=http://localhost:3002/api

# --- payment gateway --------------------------------------------------------
# Which gateway serves checkout. Switching environments is an env change only,
# no redeploy of different code:
#
#   production  → PAYMENT_PROVIDER=payriff
#   test / UAT  → PAYMENT_PROVIDER=chewick + CHEWICK_ENV=uat
#   chewick live→ PAYMENT_PROVIDER=chewick + CHEWICK_ENV=prod  (when signed off)
#
# The backend refuses to start if the selected provider's keys are missing.
# Default to payriff: a copy of this file that nobody edited must not put a
# half-tested gateway in front of real customers. Opt in to chewick explicitly.
PAYMENT_PROVIDER=payriff

# Payriff (currently the production gateway)
PAYRIFF_SECRET_KEY=your_payriff_secret_key

# Chewick — uat → https://merchant-gw.uat.chewick.com
#           prod → https://merchant-gw.chewick.com
CHEWICK_ENV=uat
CHEWICK_USERNAME=merchant@example.com
CHEWICK_PASSWORD=your_chewick_password
# Optional tuning:
# CHEWICK_BASE_URL=            # override the host derived from CHEWICK_ENV
# CHEWICK_LINK_VALID_DAYS=1    # payment link lifetime (validTo is date-only)
# CHEWICK_POLL_INTERVAL_SECONDS=30
# CHEWICK_POLL_MAX_AGE_MINUTES=180

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@yourdomain.com
SMTP_PASS=your_app_password
EMAIL_FROM=info@yourdomain.com
EMAIL_FROM_NAME=Baku Roses
ADMIN_EMAIL=admin@yourdomain.com

# Admin panel access
ADMIN_PASSWORD=bakurose2026
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
